# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/post-auth
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/post-auth

# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-host.neon.tech/dxbmotors?sslmode=require
NEON_API_KEY=

# Cloudflare R2 + Images
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=dxbmotors
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_API_TOKEN=

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# Payments — dealer plan upgrades run through Stripe Checkout. Until
# STRIPE_SECRET_KEY is set, upgrades are disabled in the UI (no fake charges
# are ever simulated). STRIPE_WEBHOOK_SECRET is required for the subscription
# to actually activate after checkout (see /api/webhooks/stripe). Create one
# recurring Price per paid tier in the Stripe dashboard and paste its ID below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PLATINUM=

# Individual per-listing fee ("100 AED or 0.95%, whichever higher"). OFF during
# the free launch. When true, a private-seller listing is held as a draft until
# the fee is paid via Stripe (needs STRIPE_SECRET_KEY). Dealers are exempt.
LISTING_FEE_ENABLED=false
# LISTING_FEE_MIN_AED=100
# LISTING_FEE_PERCENT=0.95

# Email — leads, saved-search alerts, and finance pre-approvals.
# Two providers supported; if BOTH are set, Resend wins. If NEITHER is set,
# emails log to the server console instead of sending.
#
# Option A — Resend (simplest once you own + verify a domain):
RESEND_API_KEY=
# Option B — SMTP (Gmail/Workspace, Microsoft 365, Zoho, Amazon SES SMTP, …):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shared "From" (must be on your verified domain for Resend):
SMTP_FROM=DXB Motors <leads@yourdomain.com>
LEADS_FROM_EMAIL=DXB Motors <leads@yourdomain.com>
# Optional ops fallback recipient so no lead is ever lost.
LEADS_NOTIFY_EMAIL=

# WhatsApp notifications — Meta WhatsApp Cloud API. New-lead alerts are sent to
# the seller's WhatsApp number in addition to email. If unset, they log to the
# console (no send). Get these from developers.facebook.com → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0   # optional, defaults to v21.0

# Saved-search alert cron (protects GET /api/cron/alerts). Long random string.
# CRON_SECRET is shared with the catalog-sync cron below.

# Optional: pluggable VIN vehicle-history provider (accidents/owners/title).
# When unset, the history panel shows only known + dealer-submitted facts.
VIN_HISTORY_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000

# === Vehicle catalog auto-sync ===
# Protects /api/catalog/sync when invoked by Vercel Cron / external schedulers
CRON_SECRET=
# Optional VIN decode ("Decode from VIN" in the sell wizard) — free Starter
# plan at https://auto.dev. Their specs/photos products aren't wired here —
# specs need auto.dev's paid Growth plan, photos are VIN-specific and don't
# fit a generic model catalog. See src/lib/catalog/providers.ts.
AUTO_DEV_API_KEY=
# Optional spec enrichment — free key at https://api-ninjas.com
API_NINJAS_KEY=
# Optional trim-level enrichment — https://carapi.app
CARAPI_TOKEN=
CARAPI_SECRET=
# Optional studio car renders — https://www.imagin.studio (customer key)
NEXT_PUBLIC_IMAGIN_CUSTOMER_KEY=
